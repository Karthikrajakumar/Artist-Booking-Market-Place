# Database connection
DATABASE_URL=postgresql://ind64:ind64_secret_test_password@localhost:5433/ind64_test

# Server environment
NODE_ENV=development
PORT=3000

# Secrets (min 32 characters for HMAC and session signing)
OTP_HMAC_SECRET=ind64_super_secret_otp_hmac_key_at_least_32_chars
SESSION_SECRET=ind64_super_secret_session_encryption_key_32_chars

# Session lifecycle configuration (in seconds)
SESSION_IDLE_EXPIRY_SECONDS=604800
SESSION_ABSOLUTE_EXPIRY_SECONDS=2592000

# OTP configuration
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# Allowed Origin for CSRF protection
APP_ORIGIN=http://localhost:3000
